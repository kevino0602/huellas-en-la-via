# Copia este archivo como .env y llena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API). La clave "anon/publishable" es
# pública por diseño: la seguridad real está en las reglas RLS de la base.
# NUNCA pongas aquí la clave service_role / secret.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon

# Opcional: captcha de Cloudflare Turnstile en registro e inicio de sesión.
# Si lo activas aquí, actívalo también en Supabase → Authentication → Attack Protection.
VITE_TURNSTILE_SITE_KEY=
